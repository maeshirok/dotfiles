# ターミナル環境に必要なパッケージ
# 使い方: brew bundle --file=Brewfile

# シェル・プロンプト
brew "fish"
brew "zoxide"
brew "fzf"
brew "eza"
brew "bat"

# ターミナル・エディタ
brew "tmux"
brew "neovim"
brew "ripgrep"   # LazyVim の検索に必要
brew "fd"        # LazyVim の検索に必要
brew "tree-sitter-cli"  # LazyVim(nvim-treesitter)のパーサ導入に必要

# Git 関連
brew "lazygit"
brew "git-delta"

# ツール管理(node、ghq など)
brew "mise"

# アプリ・フォント
cask "ghostty"
cask "font-plemol-jp-nf"
